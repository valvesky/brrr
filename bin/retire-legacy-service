#!/bin/sh
# Retire the systemd user service written by omapower's former setup.sh, once.
# These paths are the historical install and must stay "omapower": brrr's plugin
# supervises the helper itself. Only a unit that runs the binary setup.sh
# installed is touched; hand-written units and the old command list are left
# alone (brrr copies that list on its own first run).
set -u
data=${XDG_DATA_HOME:-$HOME/.local/share}/omapower
unit=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/omapower.service

[ -f "$unit" ] || exit 0
# setup.sh escaped \ " % $ in ExecStart for systemd; match that exact line.
exec_path=$(printf '%s\n' "$data/omapower" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/%/%%/g' -e 's/\$/$$/g')
grep -qxF "ExecStart=\"$exec_path\"" "$unit" || exit 0

# Stopping the old daemon releases its power-profile hold. If systemd is
# unreachable, keep everything so the next start retries.
systemctl --user disable --now omapower.service || exit 1
rm -f -- "$unit" "$data/omapower" "$data/setup-complete" "$data/setup.lock"
rmdir -- "$data" 2>/dev/null
systemctl --user daemon-reload || true
echo "retired the systemd service from the previous omapower setup" >&2
